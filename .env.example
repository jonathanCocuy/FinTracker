# Supabase — get these from your project's Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App URL (used in email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend — https://resend.com/api-keys
# Optional: if not set, emails are skipped silently
RESEND_API_KEY=re_your_api_key_here

# Resend — from address once your domain is verified
# Optional: defaults to FlowX <onboarding@resend.dev>
RESEND_FROM_EMAIL=FlowX <noreply@yourdomain.com>
